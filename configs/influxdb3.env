# InfluxDB 3 Core server defaults for local development.
INFLUXDB3_NODE_ID=busyness-node-0
INFLUXDB3_OBJECT_STORE=file
INFLUXDB3_DATA_DIR=/var/lib/influxdb3/data
INFLUXDB3_HTTP_BIND_ADDR=0.0.0.0:8181

# Local-only default. Set this to false and configure an admin token before
# exposing InfluxDB beyond the host machine.
INFLUXDB3_WITHOUT_AUTH=true
